{
  "name": "blogapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"pnpm --filter @blogapp/backend dev\" \"pnpm --filter @blogapp/frontend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "db:setup": "pnpm --filter @blogapp/backend db:setup",
    "db:reset": "pnpm --filter @blogapp/backend db:reset",
    "logs:generate": "node scripts/generate-logs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "concurrently": "~9.2.0",
    "eslint": "~9.39.0",
    "globals": "~16.5.0",
    "prettier": "~3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "~8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
