{
  "name": "@blogapp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:setup": "node scripts/db.mjs setup",
    "db:reset": "node scripts/db.mjs reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "~16.6.0",
    "express": "~4.22.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@blogapp/shared": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "~4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "~22.18.0",
    "@types/supertest": "^6.0.2",
    "prisma": "~6.19.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "~3.2.0"
  }
}
